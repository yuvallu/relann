# ─── Python bytecode & caches ─────────────────────────────────────────────
**/__pycache__/
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─── Virtual envs (uv) ────────────────────────────────────────────────────
.venv/
venv/
.python-version

# ─── juplit / jupytext / Jupyter ──────────────────────────────────────────
# .ipynb is generated; the .py paired file is the source of truth.
# Scope the ignore to the dirs juplit manages (relann/ and examples/),
# so research/ and any docs notebooks remain visible.
relann/**/*.ipynb
examples/**/*.ipynb
.ipynb_checkpoints/
.sync_hashes.json
t.ipynb

# ─── Logs & artefacts ─────────────────────────────────────────────────────
*.log
wandb/*
!wandb/.gitkeep
plots/
.last_checked
*.local.*

# ─── Data ─────────────────────────────────────────────────────────────────
data*/
*.pdf
# Exception: paper equation-to-DSL correspondence figures (supplementary material)
!research/paper_experiments/hgt/hgt_equations_vs_relnn.pdf
!research/paper_experiments/dhn/dhn_equations_vs_relnn.pdf

# ─── Editor / IDE ─────────────────────────────────────────────────────────
.idea/
.vscode/
*.code-workspace
.cache/

# ─── Cursor (legacy) ──────────────────────────────────────────────────────
# Rules/skills/plans were migrated to .claude/skills/ and docs/; the .cursor/
# dir now holds only local runtime state. Ignore the whole thing.
.cursor/

# ─── nbdev (legacy) ───────────────────────────────────────────────────────
# .gitconfig was generated by `nbdev_install_hooks` and is no longer in use;
# ignore it so a stray re-run of that command doesn't reintroduce it.
.gitconfig
.nbdevignore
_proc/
_docs/

# ─── Git worktrees & external clones ──────────────────────────────────────
_worktrees/
_external/
.probe_results/

# ─── Local AI tool state ──────────────────────────────────────────────────
# Ignore .claude/ session state and scratch, but keep .claude/skills/ tracked
# so shared agents have access to project skills. Git requires us to NOT
# blanket-ignore the parent .claude/ dir, otherwise the negation below is
# inert ("cannot re-include if a parent dir is excluded").
.claude/*
!.claude/skills/
CLAUDE.md

# ─── Research artefacts ───────────────────────────────────────────────────
research/paper_experiments/dhn/results/
