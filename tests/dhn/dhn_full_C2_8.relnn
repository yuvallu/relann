Cyc3_T2_1(graph_id, u, v, w; Mu_Cyc3_2_1_L3(ReLU()(Mu_Cyc3_2_1_L2(ReLU()(Mu_Cyc3_2_1_L1(z)))))) :- Hom_C3(graph_id, u, v, w; _), H0_w(graph_id, w; z) .
