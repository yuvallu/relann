Cyc7_Agg_1(graph_id, u; sum(z0 * z1 * z2 * z3 * z4 * z5 * z6)) :- Cyc7_T0_1(graph_id, u, v, w, x, y, z, a; z0), Cyc7_T1_1(graph_id, u, v, w, x, y, z, a; z1), Cyc7_T2_1(graph_id, u, v, w, x, y, z, a; z2), Cyc7_T3_1(graph_id, u, v, w, x, y, z, a; z3), Cyc7_T4_1(graph_id, u, v, w, x, y, z, a; z4), Cyc7_T5_1(graph_id, u, v, w, x, y, z, a; z5), Cyc7_T6_1(graph_id, u, v, w, x, y, z, a; z6) .

Cyc8_T0_1(graph_id, u, v, w, x, y, z, a, b; Mu_Cyc8_0_1_L3(ReLU()(Mu_Cyc8_0_1_L2(ReLU()(Mu_Cyc8_0_1_L1(z))))) * w_hom) :- Hom_C8(graph_id, u, v, w, x, y, z, a, b; w_hom), H0(graph_id, u; z) .
Cyc8_T1_1(graph_id, u, v, w, x, y, z, a, b; Mu_Cyc8_1_1_L3(ReLU()(Mu_Cyc8_1_1_L2(ReLU()(Mu_Cyc8_1_1_L1(z)))))) :- Hom_C8(graph_id, u, v, w, x, y, z, a, b; _), H0_v(graph_id, v; z) .
Cyc8_T2_1(graph_id, u, v, w, x, y, z, a, b; Mu_Cyc8_2_1_L3(ReLU()(Mu_Cyc8_2_1_L2(ReLU()(Mu_Cyc8_2_1_L1(z)))))) :- Hom_C8(graph_id, u, v, w, x, y, z, a, b; _), H0_w(graph_id, w; z) .
Cyc8_T3_1(graph_id, u, v, w, x, y, z, a, b; Mu_Cyc8_3_1_L3(ReLU()(Mu_Cyc8_3_1_L2(ReLU()(Mu_Cyc8_3_1_L1(z)))))) :- Hom_C8(graph_id, u, v, w, x, y, z, a, b; _), H0_x(graph_id, x; z) .
Cyc8_T4_1(graph_id, u, v, w, x, y, z, a, b; Mu_Cyc8_4_1_L3(ReLU()(Mu_Cyc8_4_1_L2(ReLU()(Mu_Cyc8_4_1_L1(z)))))) :- Hom_C8(graph_id, u, v, w, x, y, z, a, b; _), H0_y(graph_id, y; z) .
Cyc8_T5_1(graph_id, u, v, w, x, y, z, a, b; Mu_Cyc8_5_1_L3(ReLU()(Mu_Cyc8_5_1_L2(ReLU()(Mu_Cyc8_5_1_L1(z)))))) :- Hom_C8(graph_id, u, v, w, x, y, z, a, b; _), H0_z(graph_id, z; z) .
