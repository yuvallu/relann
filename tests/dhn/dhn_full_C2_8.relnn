d_in = 1 .
d_k = 10 .
d_hidden = 20 .
num_classes = 10 .

H0(graph_id, n; z) :- Node(graph_id, n; z) .

H0_v(graph_id, v; z) :- H0(graph_id, v; z) .
H0_w(graph_id, w; z) :- H0(graph_id, w; z) .
H0_x(graph_id, x; z) :- H0(graph_id, x; z) .
H0_y(graph_id, y; z) :- H0(graph_id, y; z) .
H0_z(graph_id, z; z) :- H0(graph_id, z; z) .
H0_a(graph_id, a; z) :- H0(graph_id, a; z) .
H0_b(graph_id, b; z) :- H0(graph_id, b; z) .

Cyc2_T0_1(graph_id, u, v; Mu_Cyc2_0_1_L3(ReLU()(Mu_Cyc2_0_1_L2(ReLU()(Mu_Cyc2_0_1_L1(z))))) * w_hom) :- Hom_C2(graph_id, u, v; w_hom), H0(graph_id, u; z) .
Cyc2_T1_1(graph_id, u, v; Mu_Cyc2_1_1_L3(ReLU()(Mu_Cyc2_1_1_L2(ReLU()(Mu_Cyc2_1_1_L1(z)))))) :- Hom_C2(graph_id, u, v; _), H0_v(graph_id, v; z) .
Cyc2_Agg_1(graph_id, u; sum(z0 * z1)) :- Cyc2_T0_1(graph_id, u, v; z0), Cyc2_T1_1(graph_id, u, v; z1) .

Cyc3_T0_1(graph_id, u, v, w; Mu_Cyc3_0_1_L3(ReLU()(Mu_Cyc3_0_1_L2(ReLU()(Mu_Cyc3_0_1_L1(z))))) * w_hom) :- Hom_C3(graph_id, u, v, w; w_hom), H0(graph_id, u; z) .
