Cyc5_Agg_1(graph_id, u; sum(z0 * z1 * z2 * z3 * z4)) :- Cyc5_T0_1(graph_id, u, v, w, x, y; z0), Cyc5_T1_1(graph_id, u, v, w, x, y; z1), Cyc5_T2_1(graph_id, u, v, w, x, y; z2), Cyc5_T3_1(graph_id, u, v, w, x, y; z3), Cyc5_T4_1(graph_id, u, v, w, x, y; z4) .

