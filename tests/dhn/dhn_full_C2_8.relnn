Cyc4_T0_1(graph_id, u, v, w, x; Mu_Cyc4_0_1_L3(ReLU()(Mu_Cyc4_0_1_L2(ReLU()(Mu_Cyc4_0_1_L1(z))))) * w_hom) :- Hom_C4(graph_id, u, v, w, x; w_hom), H0(graph_id, u; z) .
Cyc4_T1_1(graph_id, u, v, w, x; Mu_Cyc4_1_1_L3(ReLU()(Mu_Cyc4_1_1_L2(ReLU()(Mu_Cyc4_1_1_L1(z)))))) :- Hom_C4(graph_id, u, v, w, x; _), H0_v(graph_id, v; z) .
Cyc4_T2_1(graph_id, u, v, w, x; Mu_Cyc4_2_1_L3(ReLU()(Mu_Cyc4_2_1_L2(ReLU()(Mu_Cyc4_2_1_L1(z)))))) :- Hom_C4(graph_id, u, v, w, x; _), H0_w(graph_id, w; z) .
Cyc4_T3_1(graph_id, u, v, w, x; Mu_Cyc4_3_1_L3(ReLU()(Mu_Cyc4_3_1_L2(ReLU()(Mu_Cyc4_3_1_L1(z)))))) :- Hom_C4(graph_id, u, v, w, x; _), H0_x(graph_id, x; z) .
Cyc4_Agg_1(graph_id, u; sum(z0 * z1 * z2 * z3)) :- Cyc4_T0_1(graph_id, u, v, w, x; z0), Cyc4_T1_1(graph_id, u, v, w, x; z1), Cyc4_T2_1(graph_id, u, v, w, x; z2), Cyc4_T3_1(graph_id, u, v, w, x; z3) .

Cyc5_T0_1(graph_id, u, v, w, x, y; Mu_Cyc5_0_1_L3(ReLU()(Mu_Cyc5_0_1_L2(ReLU()(Mu_Cyc5_0_1_L1(z))))) * w_hom) :- Hom_C5(graph_id, u, v, w, x, y; w_hom), H0(graph_id, u; z) .
