Cyc8_T7_1(graph_id, u, v, w, x, y, z, a, b; Mu_Cyc8_7_1_L3(ReLU()(Mu_Cyc8_7_1_L2(ReLU()(Mu_Cyc8_7_1_L1(z)))))) :- Hom_C8(graph_id, u, v, w, x, y, z, a, b; _), H0_b(graph_id, b; z) .
Cyc8_Agg_1(graph_id, u; sum(z0 * z1 * z2 * z3 * z4 * z5 * z6 * z7)) :- Cyc8_T0_1(graph_id, u, v, w, x, y, z, a, b; z0), Cyc8_T1_1(graph_id, u, v, w, x, y, z, a, b; z1), Cyc8_T2_1(graph_id, u, v, w, x, y, z, a, b; z2), Cyc8_T3_1(graph_id, u, v, w, x, y, z, a, b; z3), Cyc8_T4_1(graph_id, u, v, w, x, y, z, a, b; z4), Cyc8_T5_1(graph_id, u, v, w, x, y, z, a, b; z5), Cyc8_T6_1(graph_id, u, v, w, x, y, z, a, b; z6), Cyc8_T7_1(graph_id, u, v, w, x, y, z, a, b; z7) .

H1(graph_id, n; Rho_1_L3(ReLU()(Rho_1_L2(ReLU()(Rho_1_L1(Concat(z_0, z_1, z_2, z_3, z_4, z_5, z_6))))))) :- Cyc2_Agg_1(graph_id, n; z_0), Cyc3_Agg_1(graph_id, n; z_1), Cyc4_Agg_1(graph_id, n; z_2), Cyc5_Agg_1(graph_id, n; z_3), Cyc6_Agg_1(graph_id, n; z_4), Cyc7_Agg_1(graph_id, n; z_5), Cyc8_Agg_1(graph_id, n; z_6) .

GraphEmb(graph_id; sum(z)) :- H1(graph_id, n; z) .
GraphLogits(graph_id; Classifier(z)) :- GraphEmb(graph_id; z) .

# -- FIT --

#lang:relnn
?fit <epochs=500, lr=0.001> Loss(; CrossEntropyLoss()(z_pred, z_label)) :- GraphLogits(graph_id; z_pred), GraphLabel(graph_id; z_label) .

# -- PREDICT --

#lang:relnn
?pred Predictions(graph_id; ArgMax()(z)) :- GraphLogits(graph_id; z) .
