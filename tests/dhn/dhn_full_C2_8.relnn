Cyc7_T0_1(graph_id, u, v, w, x, y, z, a; Mu_Cyc7_0_1_L3(ReLU()(Mu_Cyc7_0_1_L2(ReLU()(Mu_Cyc7_0_1_L1(z))))) * w_hom) :- Hom_C7(graph_id, u, v, w, x, y, z, a; w_hom), H0(graph_id, u; z) .
Cyc7_T1_1(graph_id, u, v, w, x, y, z, a; Mu_Cyc7_1_1_L3(ReLU()(Mu_Cyc7_1_1_L2(ReLU()(Mu_Cyc7_1_1_L1(z)))))) :- Hom_C7(graph_id, u, v, w, x, y, z, a; _), H0_v(graph_id, v; z) .
Cyc7_T2_1(graph_id, u, v, w, x, y, z, a; Mu_Cyc7_2_1_L3(ReLU()(Mu_Cyc7_2_1_L2(ReLU()(Mu_Cyc7_2_1_L1(z)))))) :- Hom_C7(graph_id, u, v, w, x, y, z, a; _), H0_w(graph_id, w; z) .
Cyc7_T3_1(graph_id, u, v, w, x, y, z, a; Mu_Cyc7_3_1_L3(ReLU()(Mu_Cyc7_3_1_L2(ReLU()(Mu_Cyc7_3_1_L1(z)))))) :- Hom_C7(graph_id, u, v, w, x, y, z, a; _), H0_x(graph_id, x; z) .
Cyc7_T4_1(graph_id, u, v, w, x, y, z, a; Mu_Cyc7_4_1_L3(ReLU()(Mu_Cyc7_4_1_L2(ReLU()(Mu_Cyc7_4_1_L1(z)))))) :- Hom_C7(graph_id, u, v, w, x, y, z, a; _), H0_y(graph_id, y; z) .
