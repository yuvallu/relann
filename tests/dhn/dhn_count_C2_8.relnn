# Count-based DHN program
# Config: MLP on pre-computed hom counts, d_in=8 (1+7 patterns), d_hidden=64
# Mathematically equivalent to full DHN with constant features
# Achieves 100%% on CSL with C2:8 patterns

# -- DEFINE --

#lang:relnn
MLP_L1 = Linear(8, 64) .
MLP_L2 = Linear(64, 64) .
MLP_L3 = Linear(64, 64) .
Classifier = Linear(64, 10) .

H(graph_id, n; MLP_L3(ReLU()(MLP_L2(ReLU()(MLP_L1(z)))))) :- Node(graph_id, n; z) .
GraphEmb(graph_id; sum(z)) :- H(graph_id, n; z) .
GraphLogits(graph_id; Classifier(z)) :- GraphEmb(graph_id; z) .

# -- FIT --

#lang:relnn
?fit <epochs=500, lr=0.001> Loss(; CrossEntropyLoss()(z_pred, z_label)) :- GraphLogits(graph_id; z_pred), GraphLabel(graph_id; z_label) .

# -- PREDICT --

#lang:relnn
?pred Predictions(graph_id; ArgMax()(z)) :- GraphLogits(graph_id; z) .
